# ── Postgres (compose + backend) ─────────────────────────────────────────────
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
POSTGRES_PORT=5544

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=16379

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=7101
FRONTEND_PORT=3200

# ── Backend ──────────────────────────────────────────────────────────────────
RADAR_DEBUG=true
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3200

# ── AI provider (zai | openai | ollama) ──────────────────────────────────────
AI_PROVIDER=zai
# OpenAI-compatible endpoint (Z.AI default shown).
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4.6
AI_FAST_MODEL=glm-4.5-air

# ── Telegram digest delivery ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Digest schedule ──────────────────────────────────────────────────────────
DIGEST_TIME=19:00
TIMEZONE=Asia/Dhaka

# ── Frontend (build-time) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:7101
