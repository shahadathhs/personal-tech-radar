# Backend
RADAR_DEBUG=true

# Postgres (local dev — compose overrides to service name "postgres")
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5544/radar

# Redis (local dev — compose overrides to service name "redis")
REDIS_URL=redis://localhost:16379/0

# CORS, comma-separated origins
CORS_ORIGINS=http://localhost:3200

# AI provider (zai | openai | ollama) — OpenAI-compatible endpoint
AI_PROVIDER=zai
AI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
AI_API_KEY=
AI_MODEL=glm-5.3
AI_FAST_MODEL=glm-5.3-flash

# Telegram digest delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Digest schedule (local time)
DIGEST_TIME=19:00
TIMEZONE=Asia/Dhaka
